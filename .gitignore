.ipynb_checkpoints/

# Build artifacts (generated by web/build.py — do not commit)
web/index.html

# Node.js (for JS test tooling)
node_modules/
package-lock.json
# ...but the web build lockfile IS committed, so `npm ci` pins the exact
# esbuild/Babel/Ajv versions the shipped index.html was built with.
!web/package-lock.json

# Playwright (e2e test artifacts — regenerated per run)
playwright-report/
test-results/
blob-report/
.playwright/
playwright/.cache/

# Validation report outputs (generated by scripts/generate_validation_report.mjs)
validation-report.json
validation-report.md

# Generated example plot (mpe_comparison.py writes it into examples/outputs/)
examples/outputs/*.png
