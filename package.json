{
  "name": "laser-mpe-skin",
  "version": "3.0.0",
  "private": true,
  "description": "Laser Maximum Permissible Exposure (MPE) calculator for skin safety",
  "license": "MIT",
  "author": "OCT Research (https://octresearch.org)",
  "repository": {
    "type": "git",
    "url": "https://github.com/CBORT-NCBIB/MPE-Calculator-Skin"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.0.0"
  },
  "scripts": {
    "build": "cd web && python3 build.py",
    "test:py": "pytest tests/ -v",
    "test:js": "node tests/test_engine_js.mjs",
