          "trace_step": null,
          "notes": "Validates band structure, formula types, correction factors, and region bounds"
        },
        {
          "id": "REQ-STD-02",
          "description": "Compute SHA-256 fingerprint of loaded standard for integrity verification",
          "implementation": {"file": "web/engine.js", "functions": ["createTracer", "_sha256"]},
          "tests": ["tests/test_tracer.mjs (T24, T32)"],
          "trace_step": "standard_snapshot.sha256",
          "notes": "Pure JS SHA-256 verified against Node.js crypto on Unicode strings"
        }
      ]
    },
